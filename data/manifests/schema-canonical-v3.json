        "denominator_rule": {
          "const": "all_terminal_shots",
          "title": "Denominator Rule",
          "type": "string"
        },
        "max_shots": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Shots",
          "type": "integer"
        },
        "search": {
          "$ref": "#/$defs/CanonicalBudgetScopeV2"
        },
        "shot": {
          "$ref": "#/$defs/CanonicalBudgetScopeV2"
        }
      },
      "required": [
        "max_shots",
        "shot",
        "search",
        "attempt",
        "denominator_rule"
      ],
      "title": "CanonicalBudgetsV2",
      "type": "object"
    },
    "CanonicalCompositionSpecV3": {
      "additionalProperties": false,
      "description": "V3 carries NMS assignments only on the update binding.",
      "properties": {
        "intervention": {
          "$ref": "#/$defs/PolicySpec"
        },
        "postprocessing": {
          "$ref": "#/$defs/PolicySpec"
        },
        "schedule": {
          "$ref": "#/$defs/SchedulePolicySpecV3"
        },
        "selection": {
          "$ref": "#/$defs/PolicySpec"
        },
        "state_memory": {
          "$ref": "#/$defs/PolicySpec"
        },
        "stopping": {
          "$ref": "#/$defs/PolicySpec"
        },
        "update": {
          "$ref": "#/$defs/PolicySpecV3"
        }
      },
      "required": [
        "update",
        "schedule",
        "state_memory",
        "intervention",
        "stopping",
        "selection",
        "postprocessing"
      ],
      "title": "CanonicalCompositionSpecV3",
      "type": "object"
    },
    "CanonicalEnvironmentV2": {
      "additionalProperties": false,
      "description": "Runtime identity for the project-owned CPU implementation only.",
      "properties": {
        "backend": {
          "const": "cpu",
          "title": "Backend",
          "type": "string"
        },
        "numpy": {
          "minLength": 1,
          "title": "Numpy",
          "type": "string"
        },
        "omp_num_threads": {
          "const": 1,
          "title": "Omp Num Threads",
          "type": "integer"
        },
        "python": {
          "minLength": 1,
          "title": "Python",
          "type": "string"
        },
        "scipy": {
          "minLength": 1,
          "title": "Scipy",
          "type": "string"
        }
      },
      "required": [
        "python",
        "numpy",
        "scipy",
        "backend",
        "omp_num_threads"
      ],
      "title": "CanonicalEnvironmentV2",
      "type": "object"
    },
    "CanonicalEvidenceV2": {
      "additionalProperties": false,
      "properties": {
        "assessment_status": {
          "const": "not_assessed",
          "title": "Assessment Status",
          "type": "string"
        },
        "discrepancies": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Discrepancies",
          "type": "array"
        },
        "fixture": {
          "const": "development_fixture",
          "title": "Fixture",
          "type": "string"
        },
        "procedure": {
          "minLength": 1,
          "title": "Procedure",
          "type": "string"
        },
        "relation": {
          "const": "canonical_implemented",
          "title": "Relation",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "relation",
        "fixture",
        "assessment_status",
        "procedure",
        "sources",
        "discrepancies"
      ],
      "title": "CanonicalEvidenceV2",
      "type": "object"
    },
    "CanonicalProfilePlanV2": {
      "additionalProperties": false,
      "properties": {
        "cohort": {
          "enum": [
            "clean",
            "representative",
            "diagnostic"
          ],
          "title": "Cohort",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "level": {
          "enum": [
            "low_overhead",
            "representative"
          ],
          "title": "Level",
          "type": "string"
        },
        "selected_before_outcome": {
          "title": "Selected Before Outcome",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "level",
        "cohort",
        "selected_before_outcome"
      ],
      "title": "CanonicalProfilePlanV2",
      "type": "object"
    },
    "CanonicalRandomnessV2": {
      "additionalProperties": false,
      "properties": {
        "decoder_seed_identity": {
          "minLength": 1,
          "title": "Decoder Seed Identity",
          "type": "string"
        },
        "sample_derivation": {
          "const": "sha256-manifest-shot-v1",
          "title": "Sample Derivation",
          "type": "string"
        },
        "sample_seed": {
          "minimum": 0,
          "title": "Sample Seed",
          "type": "integer"
        }
      },
      "required": [
        "sample_seed",
        "decoder_seed_identity",
        "sample_derivation"
      ],
      "title": "CanonicalRandomnessV2",
      "type": "object"
    },
    "CanonicalTracePlanV2": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "development_default",
            "prespecified_campaign"
          ],
          "title": "Label",
          "type": "string"
        },
        "level": {
          "enum": [
            "off",
            "full",
            "filtered"
          ],
          "title": "Level",
          "type": "string"
        },
        "max_bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_records": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Max Records",
          "type": "integer"
        },
        "relative_dir": {
          "minLength": 1,
          "title": "Relative Dir",
          "type": "string"
        }
      },
      "required": [
        "level",
        "relative_dir",
        "max_records",
        "max_bytes",
        "label"
      ],
      "title": "CanonicalTracePlanV2",
      "type": "object"
    },
    "CanonicalWorkLimitsV2": {

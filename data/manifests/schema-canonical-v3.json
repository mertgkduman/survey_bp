  "additionalProperties": false,
  "description": "Versioned public contract for promoted local-step schedule tracers.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactV1"
    },
    "budgets": {
      "$ref": "#/$defs/CanonicalBudgetsV2"
    },
    "environment": {
      "$ref": "#/$defs/CanonicalEnvironmentV2"
    },
    "error_rate": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Error Rate",
      "type": "number"

    "MatrixHashesV1": {
      "additionalProperties": false,
      "description": "Separate role- and order-sensitive identities for each CSS object.",
      "properties": {
        "hx_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hx Raw Sha256",
          "type": "string"
        },
        "hx_semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hx Semantic Sha256",
          "type": "string"
        },
        "hz_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hz Raw Sha256",
          "type": "string"
        },
        "hz_semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hz Semantic Sha256",
          "type": "string"
        },
        "lx_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lx Raw Sha256",
          "type": "string"
        },
        "lx_semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lx Semantic Sha256",
          "type": "string"
        },
        "lz_raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lz Raw Sha256",
          "type": "string"
        },
        "lz_semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lz Semantic Sha256",
          "type": "string"
        }
      },
      "required": [
        "hx_raw_sha256",
        "hz_raw_sha256",
        "lx_raw_sha256",
        "lz_raw_sha256",
        "hx_semantic_sha256",
        "hz_semantic_sha256",
        "lx_semantic_sha256",
        "lz_semantic_sha256"
      ],
      "title": "MatrixHashesV1",
      "type": "object"
    },
    "ParameterAssignment": {
      "additionalProperties": false,
      "description": "One explicit normalization assignment, never an inferred broadcast.",
      "properties": {
        "graph_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Sha256"
        },
        "shape": {
          "enum": [
            "scalar",
            "source_iteration",
            "check",
            "edge"
          ],
          "title": "Shape",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "shape"
      ],
      "title": "ParameterAssignment",
      "type": "object"
    },
    "ParameterGeneratorSpec": {
      "additionalProperties": false,
      "description": "Closed, purpose-separated generator declaration for one assignment draw.",
      "properties": {
        "algorithm": {
          "const": "numpy.PCG64",
          "default": "numpy.PCG64",
          "title": "Algorithm",
          "type": "string"
        },
        "distribution": {
          "const": "uniform",
          "title": "Distribution",
          "type": "string"
        },
        "generator_version": {
          "minLength": 1,
          "title": "Generator Version",
          "type": "string"
        },
        "graph_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Graph Sha256",
          "type": "string"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "provenance": {
          "default": "exploratory",
          "enum": [
            "source_defined",
            "exploratory"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "purpose": {
          "const": "parameter_assignment",
          "default": "parameter_assignment",
          "title": "Purpose",
          "type": "string"
        },
        "root_seed_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Seed Identity",
          "type": "string"
        },
        "shape": {
          "enum": [
            "scalar",
            "check",
            "edge"
          ],
          "title": "Shape",
          "type": "string"
        },
        "source_anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Anchor"
        }
      },
      "required": [
        "shape",
        "graph_sha256",
        "distribution",
        "low",
        "high",
        "root_seed_identity"
      ],
      "title": "ParameterGeneratorSpec",
      "type": "object"
    },
    "ParameterRefreshPlan": {
      "additionalProperties": false,
      "description": "Configuration, attempt, or source-iteration assignment refresh contract.",
      "properties": {
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterGeneratorSpec"

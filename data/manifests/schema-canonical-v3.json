        "provides": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provides",
          "type": "array"
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"

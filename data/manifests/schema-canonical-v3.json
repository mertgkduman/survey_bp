        "belief_assemblies": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Belief Assemblies",
          "type": "integer"
        },
        "bp_calls": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Bp Calls",
          "type": "integer"
        },
        "branch_expansions": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Branch Expansions",
          "type": "integer"
        },
        "branch_prunes": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Branch Prunes",
          "type": "integer"
        },
        "candidate_checks": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Candidate Checks",
          "type": "integer"
        },
        "check_to_variable_updates": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Check To Variable Updates",
          "type": "integer"
        },
        "fallback_calls": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Fallback Calls",
          "type": "integer"
        },
        "intervention_actions": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Intervention Actions",
          "type": "integer"
        },
        "relay_transfers": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Relay Transfers",
          "type": "integer"
        },
        "residual_priority_evaluations": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Residual Priority Evaluations",
          "type": "integer"
        },
        "variable_to_check_updates": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Variable To Check Updates",
          "type": "integer"
        }
      },
      "required": [
        "check_to_variable_updates",
        "variable_to_check_updates",
        "belief_assemblies",
        "residual_priority_evaluations",
        "bp_calls",
        "candidate_checks",
        "intervention_actions",
        "branch_expansions",
        "branch_prunes",
        "relay_transfers",
        "fallback_calls"

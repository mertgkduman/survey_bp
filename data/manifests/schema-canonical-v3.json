{
  "$defs": {
    "ArtifactV1": {
      "additionalProperties": false,
      "properties": {
        "code_id": {
          "minLength": 1,
          "title": "Code Id",
          "type": "string"
        },
        "format_version": {
          "const": 1,
          "title": "Format Version",
          "type": "integer"
        },
        "matrix_hashes": {
          "$ref": "#/$defs/MatrixHashesV1"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "root": {
          "minLength": 1,
          "title": "Root",
          "type": "string"
        },
        "semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Sha256",
          "type": "string"
        }
      },
      "required": [
        "root",
        "path",
        "raw_sha256",
        "semantic_sha256",
        "matrix_hashes",
        "format_version",
        "code_id"
      ],
      "title": "ArtifactV1",
      "type": "object"
    },
    "CanonicalBudgetScopeV2": {
      "additionalProperties": false,

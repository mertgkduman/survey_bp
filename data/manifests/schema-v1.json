    "paper": {"$ref": "#/$defs/PaperV1"},
    "run_id": {"minLength": 1, "title": "Run Id", "type": "string"},
    "schema_version": {"const": 1, "title": "Schema Version", "type": "integer"},
    "seed_policy": {"$ref": "#/$defs/SeedPolicyV1"}
  },
  "required": ["schema_version", "run_id", "paper", "artifact", "decoder", "noise", "seed_policy", "budget", "environment", "expected_output", "discrepancies"],
  "title": "ManifestV1",
  "type": "object"
}

{
  "$defs": {
    "ArtifactV1": {"additionalProperties": false, "properties": {"code_id": {"minLength": 1, "title": "Code Id", "type": "string"}, "format_version": {"const": 1, "title": "Format Version", "type": "integer"}, "path": {"minLength": 1, "title": "Path", "type": "string"}, "raw_sha256": {"pattern": "^[0-9a-f]{64}$", "title": "Raw Sha256", "type": "string"}, "root": {"minLength": 1, "title": "Root", "type": "string"}, "semantic_sha256": {"pattern": "^[0-9a-f]{64}$", "title": "Semantic Sha256", "type": "string"}}, "required": ["root", "path", "raw_sha256", "semantic_sha256", "format_version", "code_id"], "title": "ArtifactV1", "type": "object"},
    "BudgetV1": {"additionalProperties": false, "properties": {"denominator_rule": {"const": "all_terminal_shots", "title": "Denominator Rule", "type": "string"}, "max_iter": {"maximum": 100000, "minimum": 1, "title": "Max Iter", "type": "integer"}, "max_shots": {"maximum": 1000000, "minimum": 1, "title": "Max Shots", "type": "integer"}, "stopping_rule": {"const": "fixed_shots", "title": "Stopping Rule", "type": "string"}}, "required": ["max_shots", "max_iter", "stopping_rule", "denominator_rule"], "title": "BudgetV1", "type": "object"},
    "DecoderV1": {"additionalProperties": false, "properties": {"bp_method": {"const": "product_sum", "title": "Bp Method", "type": "string"}, "entry_point": {"const": "ldpc.BpDecoder", "title": "Entry Point", "type": "string"}, "implementation": {"const": "ldpc", "title": "Implementation", "type": "string"}, "input_vector_type": {"const": "syndrome", "title": "Input Vector Type", "type": "string"}, "parameter_names": {"items": {"enum": ["error_rate", "max_iter", "bp_method", "schedule", "input_vector_type"], "type": "string"}, "maxItems": 5, "minItems": 5, "title": "Parameter Names", "type": "array"}, "schedule": {"const": "parallel", "title": "Schedule", "type": "string"}, "version": {"minLength": 1, "title": "Version", "type": "string"}}, "required": ["implementation", "version", "entry_point", "bp_method", "schedule", "input_vector_type", "parameter_names"], "title": "DecoderV1", "type": "object"},
    "EnvironmentV1": {"additionalProperties": false, "properties": {"backend": {"const": "cpu", "title": "Backend", "type": "string"}, "ldpc": {"minLength": 1, "title": "Ldpc", "type": "string"}, "numpy": {"minLength": 1, "title": "Numpy", "type": "string"}, "python": {"minLength": 1, "title": "Python", "type": "string"}, "scipy": {"minLength": 1, "title": "Scipy", "type": "string"}}, "required": ["python", "numpy", "scipy", "ldpc", "backend"], "title": "EnvironmentV1", "type": "object"},
    "ExpectedOutputV1": {"additionalProperties": false, "properties": {"reason": {"minLength": 1, "title": "Reason", "type": "string"}, "statistical_verdict": {"anyOf": [{"enum": ["pass", "fail", "inconclusive"], "type": "string"}, {"type": "null"}], "default": null, "title": "Statistical Verdict"}, "status": {"enum": ["not_assessed", "assessed"], "title": "Status", "type": "string"}, "tolerance": {"anyOf": [{"minimum": 0, "type": "number"}, {"type": "null"}], "default": null, "title": "Tolerance"}, "values": {"items": {"type": "number"}, "title": "Values", "type": "array"}}, "required": ["status", "reason", "values"], "title": "ExpectedOutputV1", "type": "object"},
    "NoiseV1": {"additionalProperties": false, "properties": {"channel": {"const": "x_only_bit_flip", "title": "Channel", "type": "string"}, "x_error_rates": {"items": {"type": "number"}, "maxItems": 1000, "minItems": 1, "title": "X Error Rates", "type": "array"}}, "required": ["channel", "x_error_rates"], "title": "NoiseV1", "type": "object"},
    "PaperV1": {"additionalProperties": false, "properties": {"experiment_anchor": {"minLength": 1, "title": "Experiment Anchor", "type": "string"}, "relation": {"enum": ["pilot_adaptation", "source_faithful"], "title": "Relation", "type": "string"}, "revision": {"minLength": 1, "title": "Revision", "type": "string"}, "source_artifact_sha256": {"pattern": "^[0-9a-f]{64}$", "title": "Source Artifact Sha256", "type": "string"}, "source_artifact_status": {"enum": ["verified", "unverified"], "title": "Source Artifact Status", "type": "string"}, "uri": {"minLength": 1, "title": "Uri", "type": "string"}}, "required": ["uri", "revision", "experiment_anchor", "relation", "source_artifact_sha256", "source_artifact_status"], "title": "PaperV1", "type": "object"},
    "SeedPolicyV1": {"additionalProperties": false, "properties": {"derivation": {"const": "sha256-manifest-shot-v1", "title": "Derivation", "type": "string"}, "root_seed": {"minimum": 0, "title": "Root Seed", "type": "integer"}}, "required": ["root_seed", "derivation"], "title": "SeedPolicyV1", "type": "object"}
  },
  "additionalProperties": false,
  "description": "Complete, immutable settings for a pinned CSS code-capacity experiment.",
  "properties": {
    "artifact": {"$ref": "#/$defs/ArtifactV1"},
    "budget": {"$ref": "#/$defs/BudgetV1"},
    "decoder": {"$ref": "#/$defs/DecoderV1"},

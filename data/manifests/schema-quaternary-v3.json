{
  "$defs": {
    "QuaternaryChannelV1": {
      "additionalProperties": false,
      "description": "Joint physical channel and separately declared decoder smoothing.",
      "properties": {
        "decoder_smoothing": {
          "exclusiveMaximum": 0.25,
          "exclusiveMinimum": 0.0,
          "title": "Decoder Smoothing",
          "type": "number"
        },
        "probabilities": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Probabilities",
          "type": "array"
        }
      },
      "required": [
        "probabilities",
        "decoder_smoothing"
      ],
      "title": "QuaternaryChannelV1",
      "type": "object"
    },
    "QuaternaryCompositionSpec": {
      "additionalProperties": false,
      "description": "The complete Phase 10 composition surface, with no implicit bindings.",
      "properties": {
        "intervention": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuaternaryPolicySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kernel": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuaternaryPolicySpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuaternaryPolicySpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "transforms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QuaternaryPolicySpec"
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "kernel",
        "schedule"
      ],
      "title": "QuaternaryCompositionSpec",
      "type": "object"
    },
    "QuaternaryEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "assessment_status": {
          "const": "not_assessed",
          "title": "Assessment Status",
          "type": "string"
        },
        "fixture": {
          "const": "development_fixture",
          "title": "Fixture",
          "type": "string"
        },
        "interpretation": {
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "relation": {
          "const": "canonical_implemented",
          "title": "Relation",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "relation",
        "fixture",
        "assessment_status",
        "sources",
        "interpretation"
      ],
      "title": "QuaternaryEvidenceV1",
      "type": "object"
    },
    "QuaternaryPolicySpec": {
      "additionalProperties": false,
      "description": "One named policy binding with explicit data-only configuration.",
      "properties": {
        "binding_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Binding Id",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "kind": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "owned_state": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Owned State",
          "type": "array"
        },
        "provides": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provides",
          "type": "array"
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "state_lifetime": {
          "default": "attempt",
          "enum": [
            "shot",
            "attempt",
            "iteration",
            "message"
          ],
          "title": "State Lifetime",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "binding_id"
      ],
      "title": "QuaternaryPolicySpec",
      "type": "object"
    },
    "QuaternaryProblemV1": {
      "additionalProperties": false,
      "description": "Immutable non-CSS Pauli rows in explicit I/X/Y/Z encoding.",
      "properties": {
        "checks": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "syndrome": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Syndrome",
          "type": "array"
        }
      },
      "required": [
        "checks",
        "syndrome"
      ],
      "title": "QuaternaryProblemV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "New plain BP4 runs default to the promoted float64 v2 profile.",
  "properties": {
    "channel": {
      "$ref": "#/$defs/QuaternaryChannelV1"
    },
    "composition": {
      "$ref": "#/$defs/QuaternaryCompositionSpec"
    },
    "evidence": {
      "$ref": "#/$defs/QuaternaryEvidenceV1"
    },
    "max_iterations": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Iterations",
      "type": "integer"
    },
    "max_work": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Max Work",
      "type": "integer"
    },
    "numerical_profile": {
      "const": "quaternary-bp4-f64-v2",
      "default": "quaternary-bp4-f64-v2",
      "title": "Numerical Profile",
      "type": "string"
    },
    "problem": {
      "$ref": "#/$defs/QuaternaryProblemV1"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "quaternary_experiment_v3",
      "title": "Schema Version",
      "type": "string"
    },
    "shot_budget": {
      "const": 1,
      "default": 1,
      "title": "Shot Budget",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "problem",
    "channel",
    "max_iterations",
    "max_work",
    "evidence",
    "composition"
  ],
  "title": "QuaternaryExperimentV3",
  "type": "object"
}

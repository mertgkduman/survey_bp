{
  "channel_kinds": [
    "depolarizing",
    "x_only",
    "explicit",
    "embedded_circuit"
  ],
  "circuit_rule_profiles": {
    "min_sum": "binary-min-sum-flooding-f64-v1",
    "spa": "binary-spa-flooding-f64-v1"
  },
  "code_kinds": [
    "registered",
    "embedded_css"
  ],
  "cross_rule_objects": [
    {
      "if": {
        "decoder.family": "circuit_dem_bp",
        "decoder.rule": "spa"
      },
      "then": {
        "decoder.numerical_profile": "binary-spa-flooding-f64-v1"
      }
    },
    {
      "if": {
        "decoder.family": "circuit_dem_bp",
        "decoder.rule": "min_sum"
      },
      "then": {
        "decoder.numerical_profile": "binary-min-sum-flooding-f64-v1"
      }
    },
    {
      "if": {
        "decoder.variant": "qbpgd"
      },
      "then": {
        "decoder.numerical_profile": "quaternary-bp4-f64-v2"
      }
    },
    {
      "if": {
        "decoder.policy": "non_null"
      },
      "then": {
        "decoder.numerical_profile": "*_v2",
        "decoder.policy.check_rule": "decoder.rule"
      }
    },
    {
      "if": {
        "problem.kind": "circuit"
      },
      "then": {
        "channel.kind": "embedded_circuit",
        "problem.dem.decompose_errors": false,
        "rate_points.item": {
          "label": "string"
        }
      }
    },
    {
      "if": {
        "sampling.stop_failures|sampling.stop_type_i|sampling.stop_type_ii": "non_null"
      },
      "then": {
        "ci_method": "unavailable_optional_stopping",
        "sampling_mode": "adaptive_stopping"
      }
    }
  ],
  "cross_rules": [
    "custom binary and BP4 execute flooding only; schedules and interventions outside this contract are rejected",
    "Q-BPGD requires v2 and composes its guided-decimation controller with the selected flooding policy; such policy compositions are canonical adaptations unless separately source-qualified",
    "custom circuit uses the v1 Sinter adapter; noise_sweep replaces only declared matching noisy-gate probabilities",
    "physical_p and decoder_p0 are independent and serialized for every rate point",
    "registered historical studies are adapters and are not custom compiled experiments"
  ],
  "decoder_families": [
    "binary_css",
    "bp4",
    "circuit_dem_bp"
  ],
  "defaults": {
    "binary": {
      "numerical_profile": "binary-spa-flooding-f64-v2",
      "rule": "sum_product",
      "schedule": "flooding",
      "stop_on_convergence": true
    },
    "bp4": {
      "numerical_profile": "quaternary-bp4-f64-v2",

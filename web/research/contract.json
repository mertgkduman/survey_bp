  "schema": "research-experiment-v1",
  "ui_fields": {
    "decoder_p0": {
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "max_iterations": {
      "minimum": 0,
      "scope": "per_attempt; Q-BPGD total sweeps cap",
      "type": "integer"
    },
    "max_shots": {
      "constraint": "len(rate_points)*sampling.shots <= budgets.max_shots",
      "minimum": 1,
      "scope": "total_experiment",
      "type": "integer"
    },
    "physical_p": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "policy": {
      "alpha": {
        "exclusiveMinimum": 0
      },
      "beta": {
        "minimum": 0
      },
      "damping": {
        "exclusiveMaximum": 1,
        "minimum": 0
      },
      "resolution_version": "bp-resolution-v1",
      "version": "bp-flooding-policy-v1"
    },
    "shots": {
      "minimum": 1,
      "scope": "per_rate_point",
      "type": "integer"
    }
  },
  "unsupported_registered_codes": {
    "gb46": "Indexed parity-check evidence; no portable CSS/logical construction is registered for this custom runner."
  }

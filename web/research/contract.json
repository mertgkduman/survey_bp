  },
  "timing_boundaries": {
    "circuit": {
      "audit_second_decode": true,
      "decode_seconds": "per retained shot: Sinter prediction call only; excludes detector-prefix sampling, detailed audit decode, observable comparison, and file I/O",
      "end_to_end_seconds": "per retained shot: Sinter prediction + detailed canonical audit decode + observable comparison and event construction; excludes parse/DEM/setup, bounded-prefix sampling, and file I/O"
    },
    "css_code_capacity": {
      "audit_second_decode": false,
      "decode_seconds": "one decoder call (both X/Z component calls for binary), excluding graph construction and sampling",
      "end_to_end_seconds": "per shot: sampling + decoder + independent recovery evaluation; excludes graph/code setup, file I/O, and run provenance hashing"
    },
    "pauli_code_capacity": {
      "audit_second_decode": false,
      "decode_seconds": "one decoder call (both X/Z component calls for binary), excluding graph construction and sampling",
      "end_to_end_seconds": "per shot: sampling + decoder + independent recovery evaluation; excludes graph/code setup, file I/O, and run provenance hashing"
    }
  },

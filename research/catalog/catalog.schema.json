{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mertgkduman/survey_bp/research/catalog/catalog.schema.json",
  "title": "BP research catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "papers",
    "experiments",
    "datasets",
    "decoders",
    "codes",
    "circuits",
    "result_series"
  ],
  "properties": {
    "public_retired_dataset_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_version": {
      "const": 1
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paper_id",
          "title",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "paper",
              "local_study"
            ]
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "experiment_id",
          "paper_ids"
        ]
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "label",
          "evidence_status",
          "source_path"
        ]
      }
    },
    "decoders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decoder_id",
          "label"
        ]
      }
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code_id",
          "label"
        ]
      }
    },
    "circuits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "circuit_id",
          "label"
        ],
        "anyOf": [
          {
            "required": [
              "asset"
            ]
          },
          {
            "required": [
              "input_sha256"
            ]
          }
        ]
      }
    },
    "result_series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "series_id",
          "dataset_id",
          "code_id",
          "decoder_id",
          "points"
        ],
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "channel_id",
          "label",
          "kind"
        ]
      }
    },
    "paper_figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "figure_id",
          "paper_id",
          "label",
          "code_ids",
          "note",
          "source_path",
          "reproduction_rules"
        ],
        "properties": {
          "figure_id": {
            "type": "string",
            "minLength": 1
          },
          "paper_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "code_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source_figure": {
            "type": [
              "string",
              "null"
            ]
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["input_id", "label"],
              "properties": {
                "input_id": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1}
              }
            }
          },
          "reference_curves": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code_id", "channel_kind", "matches", "source_path", "source_paper_id", "source_kind", "metric", "points"],
              "properties": {
                "code_id": {"type": "string"},
                "channel_kind": {"type": "string"},
                "matches": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["dataset_id", "source_decoder_id"],
                    "properties": {
                      "dataset_id": {"type": "string"},
                      "source_decoder_id": {"type": "string"}
                    }
                  }
                },
                "source_path": {"type": "string"},
                "source_paper_id": {"type": "string"},
                "source_kind": {"enum": ["published", "digitized"]},
                "metric": {"type": "string"},
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["x", "y"],
                    "properties": {
                      "x": {"type": "number", "minimum": 0, "maximum": 1},
                      "y": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                    }
                  }
                }
              }
            }
          },
          "reproduction_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dataset_id",
                "source_decoder_ids"
              ],
              "properties": {
                "dataset_id": {
                  "type": "string"
                },
                "source_decoder_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_figure": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y",
        "n",
        "failures",
        "status"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/nullable_number"
        },
        "y": {
          "$ref": "#/$defs/nullable_number"
        },
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failures": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ci_low": {
          "$ref": "#/$defs/nullable_number"
        },
        "ci_high": {
          "$ref": "#/$defs/nullable_number"
        },
        "mean_work": {
          "$ref": "#/$defs/nullable_number"
        },
        "work_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "mean_seconds": {
          "$ref": "#/$defs/nullable_number"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
